#version 430

in vec2 vUV;
layout(location=0) out vec4 outColor;

uniform sampler2D u_AccumTex;
uniform sampler2D u_logRTex;

void main()
{
    ivec2 px = ivec2(gl_FragCoord.xy);

    vec4 accum = texelFetch(u_AccumTex, px, 0);
    float logR = texelFetch(u_logRTex,  px, 0).r;

    float reveal = clamp(exp(logR), 0.0, 1.0);

    float alpha = 1.0 - reveal;

    vec3 hairColor = (accum.a > 1e-6)
        ? accum.rgb / accum.a
        : vec3(0.0);

    vec3 bg = vec3(1.0);

    vec3 finalColor = hairColor * alpha + bg * reveal;

    outColor = vec4(finalColor, 1.0);
}