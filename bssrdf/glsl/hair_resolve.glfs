#version 430

in vec2 vUV;
layout(location=0) out vec4 outColor;

layout(binding = 0) uniform sampler2D u_AccumTex;
layout(binding = 1) uniform sampler2D u_logRTex;
layout(binding = 2) uniform sampler2D u_sceneColor;

void main()
{
    ivec2 px = ivec2(gl_FragCoord.xy);

    vec4 accum     = texelFetch(u_AccumTex, px, 0);
    float logR     = texelFetch(u_logRTex,  px, 0).r;
    vec3 sceneColor= texelFetch(u_sceneColor,px, 0).rgb;

    // Transmittance and coverage
    float Tv = clamp(exp(logR), 0.0, 1.0);
    float a  = 1.0 - Tv;

    // Representative hair color
    float weightSum = max(accum.a, 1e-4);
    vec3 Ch = (accum.a > 1e-6) ? (accum.rgb / accum.a) : vec3(0.0);

    // Optical depth derived from Tv (robust)
    float tau_v = clamp(-log(max(Tv, 1e-6)), 0.0, 8.0);

    // Light attenuation heuristic
    float k    = 0.8;
    float Tl   = exp(-k * tau_v);

    float msStrength   = 0.6;
    float densityFactor= clamp(tau_v / 4.0, 0.0, 1.0);

    vec3 Ms = Ch * msStrength * (1.0 - Tl) * densityFactor;

    vec3 hairFinal = Ch + Ms;

    // Composite over scene (scene weighted by Tv)
    outColor = vec4(hairFinal * a + sceneColor * Tv, 1.0);
}