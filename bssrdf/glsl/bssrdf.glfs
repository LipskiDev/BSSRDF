#version 430

out vec4 frag_color;


in VS_OUT {
    vec3 center;
    vec3 tangent;
    vec2 rootUV;
    float vAlong;
    vec3 viewDir;
} fs_in;

uniform vec3 u_lightdir;
uniform vec3 u_lightColor;
uniform vec3 u_ambient;

void main() {
    vec3 T = normalize(fs_in.tangent);
    vec3 V = normalize(fs_in.viewDir);
    vec3 L = normalize(u_lightdir);

    vec3 H = normalize(L + V);

    float specExp = 40.0;
    float spec = pow(max(0.0f, dot(H, T)), specExp);

    float wrap = 0.5f;
    float diff = clamp((dot(T, L) + wrap) / (1.0 + wrap), 0.0, 1.0);

    vec3 baseColor = vec3(fs_in.rootUV.x, fs_in.rootUV.y, 0.0);

    float alpha = smoothstep(1.0, 0.2, fs_in.vAlong);

    vec3 color = baseColor * (u_ambient + diff * u_lightColor) + spec * u_lightColor;

    frag_color = vec4(color * alpha, alpha);
}
