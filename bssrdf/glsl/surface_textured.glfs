#version 430

#define M_PI = 3.1415926535f

#define SAMPLES_COUNT 64
#define SAMPLES_COUNT_DIV_2 32
#define INV_SAMPLES_COUNT (1.0 / SAMPLES_COUNT)

in vec2 vUV;
in vec4 vPosLightSpace;
in vec3 vNormalWS;

uniform vec3 u_lightdir;
uniform float shadow_blur = 0.5f;

uniform float shadow_bias = 0.005;

uniform sampler2DShadow shadowMap;
uniform sampler3D jitter_tex;
uniform sampler2D uTex;


float compute_shadow_factor(vec4 p_light_space, vec3 normal)
{
    vec3 proj = p_light_space.xyz / p_light_space.w;
    proj = proj * 0.5 + 0.5;

    if (proj.x < 0.0 || proj.x > 1.0 ||
        proj.y < 0.0 || proj.y > 1.0 ||
        proj.z < 0.0 || proj.z > 1.0)
        return 1.0;

    ivec2 smSize = textureSize(shadowMap, 0);
    vec2 texel = 1.0 / vec2(smSize);

    vec2 jitter_texel_size = 1.0 / vec2(textureSize(jitter_tex, 0).xy);

    vec3 N = normalize(normal);
    vec3 L = normalize(u_lightdir);
    float ndl = max(dot(N, L), 0.0);

    const float minBias = 0.00005;
    const float slopeBias = 0.0025;

    float slope = (1.0 - ndl);
    float bias = max(minBias, slopeBias * slope);

    float dzdx = dFdx(proj.z);
    float dzdy = dFdy(proj.z);
    float rpBias = max(abs(dzdx), abs(dzdy));

    bias = max(bias, 2.0 * rpBias);

    bias *= (1.0 + 2.0 * max(texel.x, texel.y));

    vec2 baseUV = proj.xy;
    float compareZ = proj.z - bias;

    float fsize = shadow_blur * texel.x; 
    vec2 margin = texel * (0.5 + shadow_blur);
    baseUV = clamp(baseUV, margin, vec2(1.0) - margin);

    vec3 jcoord = vec3(gl_FragCoord.xy * jitter_texel_size, 0.0);

    float shadow = 0.0;

    for (int i = 0; i < SAMPLES_COUNT_DIV_2; ++i) {
        jcoord.z = (float(i) + 0.5) / float(SAMPLES_COUNT_DIV_2);
        vec4 o = texture(jitter_tex, jcoord) * 2.0 - 1.0;

        shadow += texture(shadowMap, vec3(baseUV + fsize * o.xy, compareZ));
        shadow += texture(shadowMap, vec3(baseUV + fsize * o.zw, compareZ));
    }

    return shadow * INV_SAMPLES_COUNT;
}

out vec4 FragColor;

void main() {
    vec3 N = normalize(vNormalWS);
    float shadow = compute_shadow_factor(vPosLightSpace, N);
    float NdotL = max(dot(N, u_lightdir), 0.0);
    float visibility = 1.0 - 0.5 * (1.0 - shadow * NdotL);
    vec3 color = texture(uTex, vUV / 4.0).rgb;
    color *= visibility;
	FragColor = vec4(color, 1.0);
}
