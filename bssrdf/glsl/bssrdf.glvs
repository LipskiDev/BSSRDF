#version 330

//***** begin interface of view.glsl ***********************************
mat4 get_modelview_projection_matrix();
mat4 get_modelview_matrix();
//***** end interface of view.glsl ***********************************

layout(location = 0) in vec3 in_center;
layout(location = 1) in vec3 in_tan;
layout(location = 2) in vec2 in_rootUV;
layout(location = 3) in float in_vAlong;
layout(location = 4) in float in_side;

uniform float u_widthRoot = 0.0040;
uniform float u_widthTip = 0.0015;

out VS_OUT {
	vec3 center;
	vec3 tangent;
	vec2 rootUV;
	float vAlong;
	vec3 viewDir;
} vs_out;

void main()
{
	mat4 invView = inverse(get_modelview_matrix());

	vec3 cameraPos = vec3(invView[3]);

	vec3 T = normalize(in_tan);
	vec3 V = normalize(cameraPos - in_center);
	vec3 sideVec = normalize(cross(V, T));

	float taper = in_vAlong * in_vAlong;
	float width = mix(u_widthTip, u_widthRoot, taper);
	vec3 pos = in_center + sideVec * in_side * width;

	gl_Position = get_modelview_projection_matrix() * vec4(pos, 1.0);

	vs_out.center = in_center;
	vs_out.tangent = T;
	vs_out.rootUV = in_rootUV;
	vs_out.vAlong = in_vAlong;
	vs_out.viewDir = V;
}
