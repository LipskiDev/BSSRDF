#version 330 core

layout(triangles) in;
layout(triangle_strip, max_vertices = 3) out;

uniform int u_domLayerCount;

in VS_OUT {
    float vAlong;
    float side;
    float lightDepth01;
} gs_in[];

out GS_OUT {
    float vAlong;
    float side;
    float lightDepth01;
} gs_out;

void main()
{
    float avgDepth01 =
        (gs_in[0].lightDepth01 +
         gs_in[1].lightDepth01 +
         gs_in[2].lightDepth01) / 3.0;

    int layer = int(floor(avgDepth01 * float(u_domLayerCount)));
    layer = clamp(layer, 0, u_domLayerCount - 1);

    for (int i = 0; i < 3; ++i) {
        gl_Layer = layer;
        gl_Position = gl_in[i].gl_Position;
        gs_out.vAlong = gs_in[i].vAlong;
        gs_out.side = gs_in[i].side;
        gs_out.lightDepth01 = gs_in[i].lightDepth01;
        EmitVertex();
    }
    EndPrimitive();
}