#version 330 core

layout(triangles) in;
layout(triangle_strip, max_vertices = 3) out;

uniform int u_domLayerCount;

// debug
uniform float u_domDepthMin01;
uniform float u_domDepthMax01;
uniform float u_domDepthPower;

in VS_OUT {
    float vAlong;
    float side;
    float lightDepth01;
} gs_in[];

out GS_OUT {
    float vAlong;
    float side;
    float lightDepth01;
    float layer01;
} gs_out;

void main()
{
    float avgDepth01 =
        (gs_in[0].lightDepth01 +
         gs_in[1].lightDepth01 +
         gs_in[2].lightDepth01) / 3.0;

    avgDepth01 = clamp(avgDepth01, 0.0, 1.0);

    float depthMin = clamp(u_domDepthMin01, 0.0, 1.0);
    float depthMax = clamp(u_domDepthMax01, depthMin + 1e-5, 1.0);

    float d = (avgDepth01 - depthMin) / (depthMax - depthMin);
    d = clamp(d, 0.0, 0.999);

    float power = max(u_domDepthPower, 1e-4);
    d = pow(d, power);

    int layerCount = max(u_domLayerCount, 1);
    int maxLayer = layerCount - 1;

    int layer = int(floor(d * float(layerCount)));
    layer = clamp(layer, 0, maxLayer);

    float layer01 = maxLayer > 0 ? float(layer) / float(maxLayer) : 0.0;

    for (int i = 0; i < 3; ++i) {
        gl_Layer = layer;
        gl_Position = gl_in[i].gl_Position;

        gs_out.vAlong = gs_in[i].vAlong;
        gs_out.side = gs_in[i].side;
        gs_out.lightDepth01 = gs_in[i].lightDepth01;
        gs_out.layer01 = layer01;

        EmitVertex();
    }

    EndPrimitive();
}