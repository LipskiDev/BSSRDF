#version 430

uniform mat4 u_light_space_matrix;
uniform vec3 u_lightDirWS;


layout(location = 0) in vec3 in_center;
layout(location = 1) in vec3 in_tan;
layout(location = 2) in vec2 in_rootUV;
layout(location = 3) in float in_vAlong;
layout(location = 4) in float in_side;

uniform float u_widthRoot = 0.000;
uniform float u_widthTip = 0.0005;

void main()
{
	vec3 T = normalize(in_tan);

    vec3 L = normalize(-u_lightDirWS);
    vec3 sideVec = normalize(cross(L, T));

    float taper = in_vAlong * in_vAlong;
    float width = mix(u_widthRoot, u_widthTip, taper);
    vec3 pos = in_center + sideVec * in_side * width;

    gl_Position = u_light_space_matrix * vec4(pos, 1.0);
}
