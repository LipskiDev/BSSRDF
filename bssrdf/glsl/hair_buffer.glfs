#version 430

layout(location=0) out vec4 outAccum;
layout(location=1) out float outLogR;

uniform sampler2D u_IrradianceBasis0;
uniform sampler2D u_IrradianceBasis1;
uniform sampler2D u_IrradianceBasis2;
uniform sampler2D u_IrradianceBasis3;
uniform sampler2D u_IrradianceBasis4;
uniform sampler2D fur_color;
uniform sampler2D u_domTau;

uniform float u_w0;
uniform float u_w1;
uniform float u_w2;
uniform float u_w3;
uniform float u_w4;

uniform mat4 u_lightSpaceMatrix;

uniform float u_scatterStrength;

in VS_OUT {
    vec3 posOS;
    vec3 T;
    vec3 V;
    float vAlong;
    vec2 rootUV;
} fs_in;

uniform vec3 u_lightdir;
uniform vec3 u_lightColor;

void main()
{
    // --- basis ---
    vec3 T = normalize(fs_in.T);
    vec3 V = normalize(fs_in.V);
    vec3 L = normalize(u_lightdir);

    // --- stable tangent variation (critical for realism) ---
    float noise = texture(fur_color, fs_in.rootUV * 10.0).r;
    float angle = (noise - 0.5) * 0.25;

    vec3 up = abs(T.y) < 0.99 ? vec3(0,1,0) : vec3(1,0,0);
    vec3 N = normalize(cross(T, up));
    T = normalize(T + N * angle);

    // --- angles ---
    float TL = dot(T, L);
    float TV = dot(T, V);

    float sinTL = sqrt(max(0.0, 1.0 - TL * TL));
    float sinTV = sqrt(max(0.0, 1.0 - TV * TV));

    vec3 H = normalize(L + V);
    float TH = dot(T, H);

    // --- DOM (transmittance) ---
    vec4 lightClip = u_lightSpaceMatrix * vec4(fs_in.posOS, 1.0);
    vec3 ndc = lightClip.xyz / lightClip.w;
    vec2 uv = ndc.xy * 0.5 + 0.5;

    float tau = texture(u_domTau, uv).r;

    float noiseTl = texture(fur_color, fs_in.rootUV * 4.0).r;
    tau *= mix(0.7, 1.3, noiseTl);

    float Tl = exp(-tau * 0.5);

    vec3 baseColor = texture(fur_color, fs_in.rootUV).rgb;

    // =========================================================
    // 🌟 3-LOBE HAIR MODEL
    // =========================================================

    // --- R lobe (surface reflection) ---
    float sinTH = sqrt(max(0.0, 1.0 - TH * TH));
    float R_lobe = pow(sinTH, 80.0);              // tight

    float grazing = pow(1.0 - abs(TL), 3.0);      // grazing boost

    vec3 R = u_lightColor * R_lobe;
    R *= (0.6 + 1.8 * grazing);
    R *= mix(1.0, Tl, 0.02);                      // mostly shell

    // --- TT lobe (transmission) ---
    float TT_lobe = pow(sinTL, 1.5);              // broad

    vec3 TT = baseColor * TT_lobe * u_lightColor;
    TT *= mix(0.1, 1.0, Tl);                      // attenuated inside

    // --- TRT lobe (internal reflection / colored glints) ---
    float shift = 0.2;
    float t = clamp(TH + shift, -1.0, 1.0);

    float TRT_lobe = pow(sqrt(max(0.0, 1.0 - t * t)), 20.0);

    vec3 TRT = baseColor * u_lightColor * TRT_lobe;
    TRT *= pow(1.0 - Tl, 1.8);                    // interior-biased
    TRT *= 0.35;

    // =========================================================
    // 🌫️ MULTIPLE SCATTERING (your basis)
    // =========================================================

    vec3 B0 = texture(u_IrradianceBasis0, fs_in.rootUV).rgb;
    vec3 B1 = texture(u_IrradianceBasis1, fs_in.rootUV).rgb;
    vec3 B2 = texture(u_IrradianceBasis2, fs_in.rootUV).rgb;
    vec3 B3 = texture(u_IrradianceBasis3, fs_in.rootUV).rgb;
    vec3 B4 = texture(u_IrradianceBasis4, fs_in.rootUV).rgb;

    vec3 Sss =
        (u_w0 * B0 +
         u_w1 * B1 +
         u_w2 * B2 +
         u_w3 * B3 +
         u_w4 * B4);

    float scatterMask = pow(1.0 - Tl, 1.8);

    Sss *= baseColor;
    Sss *= u_scatterStrength;
    Sss *= scatterMask * 0.18;

    // =========================================================
    // ✨ SHELL + RIM ENHANCEMENT
    // =========================================================

    float shell = pow(Tl, 1.5);
    vec3 shellBoost = baseColor * 0.15 * shell;

    float rim = pow(1.0 - abs(dot(T, V)), 2.0);
    vec3 rimLight = baseColor * 0.12 * rim;

    // =========================================================
    // FINAL COMBINE
    // =========================================================

    float alpha = mix(0.40, 0.18, fs_in.vAlong);
    float alphaScatter = sqrt(clamp(alpha, 0.0, 1.0));

    vec3 C =
        R +          // shell highlight
        TT +         // soft body light
        TRT +        // internal color response
        Sss * alphaScatter +
        shellBoost +
        rimLight;

    outAccum = vec4(C * alpha, alpha);

    float oneMinusA = max(1.0 - alpha, 1e-4);
    outLogR = log(oneMinusA);
}