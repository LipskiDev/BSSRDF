#version 430

layout(location=0) out vec4 outAccum;
layout(location=1) out float outLogR;

uniform sampler2D u_IrradianceBasis0;
uniform sampler2D u_IrradianceBasis1;
uniform sampler2D u_IrradianceBasis2;
uniform sampler2D u_IrradianceBasis3;
uniform sampler2D u_IrradianceBasis4;
uniform sampler2D fur_color;
uniform sampler2DArray u_domTau;
uniform int u_domLayerCount;
 
uniform float u_w0;
uniform float u_w1;
uniform float u_w2;
uniform float u_w3;
uniform float u_w4;

uniform mat4 u_lightSpaceMatrix;

uniform float u_scatterStrength;

uniform float u_rLobeExp;
uniform float u_rGrazingStrength;
uniform float u_rShellMix;

uniform float u_ttLobeExp;
uniform float u_ttTransmissionMin;

uniform float u_trtShift;
uniform float u_trtLobeExp;
uniform float u_trtStrength;
uniform float u_trtInteriorExp;

uniform float u_sssMaskExp;
uniform float u_sssStrength;

uniform float u_shellStrength;
uniform float u_shellExp;
uniform float u_rimStrength;
uniform float u_rimExp;

uniform float u_alphaRoot;
uniform float u_alphaTip;

uniform float u_tauScale;
uniform float u_tauNoiseMin;
uniform float u_tauNoiseMax;
uniform float u_tangentNoiseScale;
uniform float u_tangentNoiseAngle;
uniform float u_tauNoiseScale;

uniform bool u_debugShowR;
uniform bool u_debugShowTT;
uniform bool u_debugShowTRT;
uniform bool u_debugShowSSS;
uniform bool u_debugShowShell;
uniform bool u_debugShowRim;
uniform bool u_debugShowTau;
uniform bool u_debugShowAlpha;

in VS_OUT {
    vec3 posOS;
    vec3 T;
    vec3 V;
    float vAlong;
    vec2 rootUV;
} fs_in;

uniform vec3 u_lightdir;
uniform vec3 u_lightColor;

float sampleDOMTransmittance(vec2 uv, float lightDepth01)
{
    int maxLayer = int(floor(lightDepth01 * float(u_domLayerCount)));
    maxLayer = clamp(maxLayer, 0, u_domLayerCount - 1);

    float tau = 0.0;

    for (int i = 0; i <= maxLayer; ++i) {
        tau += texture(u_domTau, vec3(uv, float(i))).r;

        // early exit for performance + stability
        if (tau > 10.0)
            break;
    }

    return exp(-tau * u_tauScale);
}

void main()
{
    vec3 T = normalize(fs_in.T);
    vec3 V = normalize(fs_in.V);
    vec3 L = normalize(-u_lightdir);

    float noise = texture(fur_color, fs_in.rootUV * u_tangentNoiseScale).r;
    float angle = (noise - 0.5) * u_tangentNoiseAngle;

    vec3 up = abs(T.y) < 0.99 ? vec3(0,1,0) : vec3(1,0,0);
    vec3 N = normalize(cross(T, up));
    T = normalize(T + N * angle);

    float TL = dot(T, L);
    float TV = dot(T, V);

    float sinTL = sqrt(max(0.0, 1.0 - TL * TL));
    float sinTV = sqrt(max(0.0, 1.0 - TV * TV));

    vec3 H = normalize(L + V);
    float TH = dot(T, H);

    vec4 lightClip = u_lightSpaceMatrix * vec4(fs_in.posOS, 1.0);
    vec3 ndc = lightClip.xyz / lightClip.w;
    vec2 uv = ndc.xy * 0.5 + 0.5;

    float lightDepth01 = clamp(ndc.z * 0.5 + 0.5, 0.0, 1.0);
    float Tl = sampleDOMTransmittance(uv, lightDepth01);
    float noiseTl = texture(fur_color, fs_in.rootUV * u_tauNoiseScale).r;
    float noiseFactor = mix(u_tauNoiseMin, u_tauNoiseMax, noiseTl);
    
    // convert back to tau-space, apply noise, then back to T
    float tauFromDOM = -log(max(Tl, 1e-6));
    tauFromDOM *= noiseFactor;
    Tl = exp(-tauFromDOM);

    vec3 baseColor = texture(fur_color, fs_in.rootUV).rgb;

    float sinTH = sqrt(max(0.0, 1.0 - TH * TH));
    float R_lobe = pow(sinTH, u_rLobeExp);
    float grazing = pow(1.0 - abs(TL), 3.0);

    vec3 R = u_lightColor * R_lobe;
    R *= (0.6 + u_rGrazingStrength * grazing);
    R *= mix(1.0, Tl, u_rShellMix);

    float TT_lobe = pow(sinTL, u_ttLobeExp);
    vec3 TT = baseColor * TT_lobe * u_lightColor;
    TT *= mix(u_ttTransmissionMin, 1.0, Tl);

    float t = clamp(TH + u_trtShift, -1.0, 1.0);
    float TRT_lobe = pow(sqrt(max(0.0, 1.0 - t * t)), u_trtLobeExp);

    vec3 TRT = baseColor * u_lightColor * TRT_lobe;
    TRT *= pow(1.0 - Tl, u_trtInteriorExp);
    TRT *= u_trtStrength;

    vec3 B0 = texture(u_IrradianceBasis0, fs_in.rootUV).rgb;
    vec3 B1 = texture(u_IrradianceBasis1, fs_in.rootUV).rgb;
    vec3 B2 = texture(u_IrradianceBasis2, fs_in.rootUV).rgb;
    vec3 B3 = texture(u_IrradianceBasis3, fs_in.rootUV).rgb;
    vec3 B4 = texture(u_IrradianceBasis4, fs_in.rootUV).rgb;

    vec3 Sss =
        (u_w0 * B0 +
         u_w1 * B1 +
         u_w2 * B2 +
         u_w3 * B3 +
         u_w4 * B4);

    float scatterMask = pow(1.0 - Tl, u_sssMaskExp);

    Sss *= baseColor;
    Sss *= u_scatterStrength;
    Sss *= scatterMask * u_sssStrength;

    float shell = pow(Tl, u_shellExp);
    vec3 shellBoost = baseColor * u_shellStrength * shell;

    float rim = pow(1.0 - abs(dot(T, V)), u_rimExp);
    vec3 rimLight = baseColor * u_rimStrength * rim;

    float alpha = mix(u_alphaRoot, u_alphaTip, fs_in.vAlong);
    float alphaScatter = sqrt(clamp(alpha, 0.0, 1.0));

    if (u_debugShowR) {
        outAccum = vec4(R * alpha, alpha);
        outLogR = log(max(1.0 - alpha, 1e-4));
        return;
    }
    if (u_debugShowTT) {
        outAccum = vec4(TT * alpha, alpha);
        outLogR = log(max(1.0 - alpha, 1e-4));
        return;
    }
    if (u_debugShowTRT) {
        outAccum = vec4(TRT * alpha, alpha);
        outLogR = log(max(1.0 - alpha, 1e-4));
        return;
    }
    if (u_debugShowSSS) {
        outAccum = vec4(Sss * alphaScatter * alpha, alpha);
        outLogR = log(max(1.0 - alpha, 1e-4));
        return;
    }
    if (u_debugShowShell) {
        outAccum = vec4(shellBoost * alpha, alpha);
        outLogR = log(max(1.0 - alpha, 1e-4));
        return;
    }
    if (u_debugShowRim) {
        outAccum = vec4(rimLight * alpha, alpha);
        outLogR = log(max(1.0 - alpha, 1e-4));
        return;
    }
    if (u_debugShowTau) {
        float tauDbg = -log(max(Tl, 1e-6));
        vec3 dbg = vec3(clamp(tauDbg * 0.25, 0.0, 1.0));
        outAccum = vec4(dbg, 1.0);
        outLogR = 0.0;
        return;
    }
    if (u_debugShowAlpha) {
        outAccum = vec4(vec3(alpha), 1.0);
        outLogR = 0.0;
        return;
    }

    vec3 C =
        R +
        TT +
        TRT +
        Sss * alphaScatter +
        shellBoost +
        rimLight;

    outAccum = vec4(C * alpha, alpha);

    float oneMinusA = max(1.0 - alpha, 1e-4);
    outLogR = log(oneMinusA);
}