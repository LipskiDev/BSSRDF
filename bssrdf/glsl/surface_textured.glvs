#version 330 core

//***** begin interface of view.glsl ***********************************
mat4 get_modelview_projection_matrix();
mat4 get_modelview_matrix();
//***** end interface of view.glsl ***********************************

uniform mat4 u_model_matrix;
uniform mat3 u_model_normal_matrix;
uniform mat4 u_lightSpaceMatrix;
uniform vec2 u_uv_scale;

layout(location = 0) in vec3 aPos;
layout(location = 1) in vec3 aNormal;
layout(location = 2) in vec2 aUV;

out vec2 vUV;
out vec3 vNormalWS;
out vec3 vPosWS;
out vec4 vPosLightSpace;

void main()
{
    vec4 worldPos = u_model_matrix * vec4(aPos, 1.0);

    vPosWS = worldPos.xyz;
    vNormalWS = normalize(u_model_normal_matrix * aNormal);
    vUV = aUV * u_uv_scale;
    vPosLightSpace = u_lightSpaceMatrix * vec4(aPos, 1.0);

    gl_Position = get_modelview_projection_matrix() * vec4(aPos, 1.0);
}