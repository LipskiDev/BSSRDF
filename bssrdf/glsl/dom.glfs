#version 330 core

layout(location = 0) out float outTau;

in GS_OUT {
    float vAlong;
    float side;
    float lightDepth01;
} fs_in;

void main()
{
    float vAlong = clamp(fs_in.vAlong, 0.0, 1.0);
    float side   = clamp(fs_in.side, -1.0, 1.0);

    float along = mix(0.45, 1.0, 1.0 - vAlong);
    float cross = pow(max(0.0, 1.0 - abs(side)), 0.8);

    float tau = 0.08 * along * cross;
    outTau = tau;
}